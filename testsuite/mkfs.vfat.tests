. ./testing.sh

# testing "test name" "options" "expected result" "file input" "stdin"

optional BLKID
# This creates 32MB FAT32 image, and tests that blkid does recognize it.
# This is technically incorrect: at this size, image should be FAT16
# according to Microsoft rules (it says that FAT12/16/32-ness of the volume
# is _solely_ determined by cluster count).
# But Linux kernel happily mounts these small FAT32 images.
testing "mkfs.vfat 32MB image" \
	"dd if=/dev/zero of=input bs=512 count=65536 2>/dev/null; mkfs.vfat input 2>&1 && blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/' " \
'input: UUID="xxxx-xxxx" TYPE="vfat"
' '' ''

# The minimal image with default -b6 -R32 (has just 2 FAT sectors and 2 data sectors)
testing "mkfs.vfat 18KB image" \
	"mkfs.vfat input 18 2>&1 && blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/' " \
'input: UUID="xxxx-xxxx" TYPE="vfat"
' '' ''

# The minimal image which can still be mounted and can have non-zero-length files
testing "mkfs.vfat -b0 -R2 3KB image" \
	"mkfs.vfat -b0 -R2 input 3 2>&1 && blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/' " \
'input: UUID="xxxx-xxxx" TYPE="vfat"
' '' ''

# Create maximal possible one-sector-per-cluster FAT32:
# FATs should have precisely 2097152 sectors: this holds enough entries for 2097152*512/4 = 0x10000000 clusters.
# Actual number of clusters should be 268435445 = 0x0ffffff5 (the maximum cluster# is 0x0ffffff6).
testing "mkfs.vfat -b0 -R3 -s1 136314876 kbyte (130GB) image" \
	"rm input \\
	&& mkfs.vfat -v -F32 -b0 -R3 -s1 -C input 136314876 2>&1 | grep -eclusters:268435445 -esectors/FAT:2097152 \\
	&& blkid input | sed 's/\"....-....\"/\"xxxx-xxxx\"/'
	" \
'total sectors:272629752, clusters:268435445, sectors/cluster:1
FATs:2, sectors/FAT:2097152
input: UUID="xxxx-xxxx" TYPE="vfat"
' '' ''

testing "mkfs.vfat 360" \
	"mkfs.vfat -n FSLABEL input 360 2>&1 && hexdump -C input | sed 's/....FSLAB.\$/xxxxFSLAB|/;s/..  .. .. .. 46 53 4c 41 42  /xx  xx xx xx 46 53 4c 41 42  /'" \
'00000000  eb 58 90 6d 6b 64 6f 73  66 73 00 00 02 02 01 00  |.X.mkdosfs......|
00000010  02 70 00 d0 02 fd 02 00  09 00 02 00 00 00 00 00  |.p..............|
00000020  d0 02 00 00 00 00 29 xx  xx xx xx 46 53 4c 41 42  |......)xxxxFSLAB|
00000030  45 4c 20 20 20 20 46 41  54 31 32 20 20 20 00 00  |EL    FAT12   ..|
00000040  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000050  00 00 00 00 00 00 00 00  00 00 0e 1f be 77 7c ac  |.............w|.|
00000060  22 c0 74 0b 56 b4 0e bb  07 00 cd 10 5e eb f0 32  |".t.V.......^..2|
00000070  e4 cd 16 cd 19 eb fe 54  68 69 73 20 69 73 20 6e  |.......This is n|
00000080  6f 74 20 61 20 62 6f 6f  74 61 62 6c 65 20 64 69  |ot a bootable di|
00000090  73 6b 0d 0a 00 00 00 00  00 00 00 00 00 00 00 00  |sk..............|
000000a0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
*
000001f0  00 00 00 00 00 00 00 00  00 00 00 00 00 00 55 aa  |..............U.|
00000200  fd ff ff 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000210  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
*
00000600  fd ff ff 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
00000610  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
*
00000a00  46 53 4c 41 42 45 4c 20  20 20 20 08 00 00 00 00  |FSLABEL    .....|
00000a10  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
*
0005a000
' '' ''

